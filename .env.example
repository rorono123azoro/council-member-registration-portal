# Application
APP_NAME="Council Member Registration Portal"
COUNCIL_NAME="National Civic & Professional Council"
APP_ENV=production
APP_URL=http://localhost:8000
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=council_portal
DB_USER=root
DB_PASS=

# Mail (PHPMailer SMTP)
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@councilportal.local
MAIL_FROM_NAME="Council Member Registration Portal"
MAIL_ENCRYPTION=tls

# Security
SESSION_LIFETIME=7200
RATE_LIMIT_REGISTER=5
RATE_LIMIT_CHECK_UNIQUE=30
RATE_LIMIT_LOGIN=5
LOCKOUT_MINUTES=15
